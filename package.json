{
  "name": "marspath-spaceapps-2026",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:worker && next dev --hostname 0.0.0.0",
    "build": "npm run build:worker && next build && node scripts/prepare-static.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:worker": "esbuild lib/routing.worker.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=public/route-worker.js"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "ol": "10.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
